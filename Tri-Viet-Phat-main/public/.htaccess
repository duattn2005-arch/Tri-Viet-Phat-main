RewriteRule ^tin\-tuyen\-dung/?$ /tuyen-dung [R=301,L,NE]
RewriteRule ^chuyen\-muc\-tuyen\-dung/nhan\-vien\-kinh\-doanh/?$ /tuyen-dung [R=301,L,NE]
RewriteRule ^chuyen\-muc\-tuyen\-dung/nhan\-vien\-ky\-thuat/?$ /tuyen-dung [R=301,L,NE]
RewriteRule ^gioi\-thieu\-tri\-duc/?$ /gioi-thieu [R=301,L,NE]
RewriteRule ^tag(/.*)?$ /tin-tuc [R=301,L,NE]
RewriteRule ^tu\-khoa\-san\-pham(/.*)?$ /san-pham [R=301,L,NE]
RewriteRule ^danh\-muc\-san\-pham(/.*)?$ /san-pham [R=301,L,NE]
RewriteRule ^author(/.*)?$ / [R=301,L,NE]
RewriteRule ^en/?$ / [R=301,L,NE]
RewriteRule ^en(/.*)?$ / [R=301,L,NE]
RewriteRule ^feed(/.*)?$ /tin-tuc [R=301,L,NE]
RewriteRule ^wp\-admin(/.*)?$ /admin/ [R=302,L,NE]
RewriteRule ^wp\-login\.php/?$ /admin/ [R=302,L,NE]
# END old WordPress URLs

# /gioi-thieu.html -> /gioi-thieu
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Real files and the admin folder are served as is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_URI} ^/admin/
RewriteRule ^ - [L]

# /gioi-thieu -> gioi-thieu.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Everything else -> the app
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
