# Apache / cPanel hosting: pretty URLs for the single-page app.
# Each page has a pre-built HTML file (e.g. gioi-thieu.html) carrying its own title and meta tags;
# any other path falls back to index.html and the app shows the matching screen.
Options -MultiViews -Indexes
DirectorySlash Off
# The old WordPress index.php must never win over the app
DirectoryIndex index.html
RewriteEngine On

# Secrets written at deploy time (readable by PHP only) and the FTP deploy's sync state
<FilesMatch "^((telegram|cms|email|ai)-config(\.example)?\.php|\.ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# www -> bare domain
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /admin -> /admin/ (Decap CMS)
RewriteRule ^admin$ /admin/ [R=301,L]

# BEGIN old WordPress URLs
# Generated from the old site's sitemaps: every old URL goes to the matching new page (301).
RewriteRule ^en/lets\-learn\-about\-the\-testing\-machines\-in\-the\-laboratory/?$ /tin-tuc [R=301,L,NE]
